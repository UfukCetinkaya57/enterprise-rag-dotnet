{
  "//": "Production overrides. appsettings.json'un üzerine biner (ASPNETCORE_ENVIRONMENT=Production).",

  "Ai": {
    "Provider": "Gemini"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Information"
    }
  },

  "Rag": {
    "//": "Gemini free-tier rate limit'ini korumak için: faithfulness KAPALI + rerank HYBRID.",
    "//2": "Böylece soru başına yalnızca 1 Gemini çağrısı (answer) kalır — 429 riski minimize.",
    "Retrieval": {
      "TopK": 20,
      "TopN": 4,
      "RerankerType": "Hybrid"
    },
    "Faithfulness": {
      "Threshold": 0.7,
      "Enabled": false
    },
    "Security": {
      "PromptGuardAction": "SanitizeAndWarn"
    }
  },

  "Demo": {
    "Enabled": true,
    "DiagnosticsEnabled": false,
    "//budget": "Gemini free-tier: token ~sıfır maliyet ama günlük istek/dakika limiti var; bütçe yine de tavan.",
    "DailyTokenBudget": 150000,
    "DocumentTtlHours": 24,
    "Ip": {
      "QueriesPerDay": 30,
      "UploadsPerDay": 3
    },
    "Session": {
      "MaxDocuments": 2,
      "MaxTotalBytes": 20971520
    },
    "Cache": {
      "TtlHours": 24
    },
    "Upload": {
      "MaxBytes": 10485760,
      "MaxPages": 50
    }
  }
}
