{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Ai": {
    "//": "Aktif sağlayıcı: 'OpenAI' veya 'Gemini'. Provider-agnostik — tek anahtar.",
    "Provider": "OpenAI"
  },

  "Gemini": {
    "//": "ApiKey buraya YAZILMAZ — .env / GEMINI_API_KEY'den gelir.",
    "BaseUrl": "https://generativelanguage.googleapis.com/v1beta",
    "EmbeddingModel": "gemini-embedding-001",
    "EmbeddingDimensions": 768,
    "ChatModel": "gemini-flash-lite-latest",
    "Pricing": {
      "ChatInputPerMillion": 0.0,
      "ChatOutputPerMillion": 0.0,
      "EmbeddingPerMillion": 0.0
    }
  },

  "OpenAI": {
    "//": "ApiKey buraya YAZILMAZ — .env / OPENAI_API_KEY ortam değişkeninden gelir.",
    "BaseUrl": "https://api.openai.com/v1",
    "EmbeddingModel": "text-embedding-3-small",
    "EmbeddingDimensions": 1536,
    "ChatModel": "gpt-4o-mini",
    "MaxRetries": 3,
    "Pricing": {
      "ChatInputPerMillion": 0.15,
      "ChatOutputPerMillion": 0.60,
      "EmbeddingPerMillion": 0.02
    }
  },

  "Rag": {
    "Chunking": {
      "MaxTokens": 180,
      "OverlapRatio": 0.15
    },
    "Retrieval": {
      "TopK": 20,
      "TopN": 4,
      "Hybrid": false
    },
    "Faithfulness": {
      "Threshold": 0.7,
      "Enabled": true
    },
    "Conversation": {
      "Enabled": false,
      "HistoryWindow": 5
    },
    "Security": {
      "PromptGuardAction": "SanitizeAndWarn"
    }
  },

  "Demo": {
    "Enabled": true,
    "SeedSessionId": "seed",
    "SeedEnabled": true,
    "SeedFilePath": "SeedData/seed-policy.pdf",
    "DailyTokenBudget": 200000,
    "DocumentTtlHours": 24,
    "Ip": {
      "QueriesPerDay": 30,
      "UploadsPerDay": 3
    },
    "Session": {
      "MaxDocuments": 2,
      "MaxTotalBytes": 20971520
    },
    "Cache": {
      "//": "Provider: 'Postgres' (varsayılan, ek altyapısız) veya 'Redis' (dağıtık).",
      "//2": "RedisConnection .env / REDIS_CONNECTION'dan; RedisKeyPrefix paylaşımlı Redis'te izolasyon sağlar.",
      "TtlHours": 24,
      "Provider": "Postgres",
      "RedisConnection": "localhost:6379",
      "RedisKeyPrefix": "rag:cache:"
    },
    "Upload": {
      "MaxBytes": 10485760,
      "MaxPages": 50
    }
  },

  "Cohere": {
    "//": "Cross-encoder rerank (Rag:Retrieval:RerankerType='Cohere' ise). ApiKey .env / COHERE_API_KEY'den.",
    "BaseUrl": "https://api.cohere.com",
    "Model": "rerank-multilingual-v3.0"
  }
}
