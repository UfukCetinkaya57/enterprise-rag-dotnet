{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "OpenAI": {
    "//": "ApiKey buraya YAZILMAZ — .env / OPENAI_API_KEY ortam değişkeninden gelir.",
    "BaseUrl": "https://api.openai.com/v1",
    "EmbeddingModel": "text-embedding-3-small",
    "EmbeddingDimensions": 1536,
    "ChatModel": "gpt-4o-mini",
    "MaxRetries": 3
  },

  "Rag": {
    "Chunking": {
      "MaxTokens": 600,
      "OverlapRatio": 0.12
    },
    "Retrieval": {
      "TopK": 20,
      "TopN": 5
    },
    "Faithfulness": {
      "Threshold": 0.6,
      "Enabled": true
    }
  }
}
