# Bu dosyayı ".env.prod" olarak kopyalayın ve gerçek değerleri doldurun.
# .env.prod .gitignore'dadır — ASLA commit'lenmez.
# Kullanım: docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# --- AI sağlayıcı seçimi: "Gemini" (ücretsiz katman) veya "OpenAI" ---
Ai__Provider=Gemini

# --- Gemini (ücretsiz): aistudio.google.com/apikey ---
GEMINI_API_KEY=your-gemini-key-here

# --- OpenAI (Ai__Provider=OpenAI ise doldur) ---
OPENAI_API_KEY=

# --- Ortam ---
ASPNETCORE_ENVIRONMENT=Production

# --- API bind portu (yalnızca 127.0.0.1'e; Nginx buraya proxy'ler) ---
API_PORT=8092

# --- PostgreSQL (pgvector) ---
POSTGRES_DB=kurumsalrag
POSTGRES_USER=rag
# GÜÇLÜ bir parola girin (DB dışarı açılmıyor ama yine de).
POSTGRES_PASSWORD=change-me-strong-password
